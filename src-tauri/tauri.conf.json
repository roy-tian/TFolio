{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TFolio",
  "version": "../package.json",
  "identifier": "com.roytian.tfolio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TFolio",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Roy Tian"
  }
}
