{
  "name": "tfolio",
  "private": true,
  "version": "0.1.3",
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  },
  "description": "A PDF editor built with Tauri and Rust.",
  "author": "Roy Tian",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "test": "bun test",
    "test:all": "bun run test && bun run pdfium:download && bun run fonts:download && cargo test --manifest-path src-tauri/Cargo.toml --locked && cargo test --manifest-path src-tauri/Cargo.toml --locked -- --ignored && bun run test:e2e",
    "test:e2e": "bun run test:e2e:build && bun run test:e2e:headless",
    "test:e2e:build": "bun run pdfium:download && bun run fonts:download && bun run test:e2e:types && tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e:headless": "xvfb-run -a bun run test:e2e:run",
    "test:e2e:run": "wdio run wdio.conf.ts",
    "test:e2e:types": "tsc --noEmit -p tsconfig.e2e.json",
    "pdfium:download": "bun scripts/download-pdfium.mjs",
    "fonts:download": "bun scripts/download-fonts.mjs",
    "pretauri:dev": "bun run pdfium:download && bun run fonts:download",
    "pretauri:build": "bun run pdfium:download && bun run fonts:download",
    "pretauri:bundle": "bun run pdfium:download && bun run fonts:download",
    "preview": "vite preview",
    "preflight": "bun scripts/preflight.mjs",
    "prepare": "husky",
    "version:bump": "bun scripts/version.mjs",
    "version:check": "bun scripts/version.mjs --check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:bundle": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@wdio/cli": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
