{
  "name": "tfolio",
  "private": true,
  "version": "0.1.27",
  "packageManager": "bun@1.4.4",
  "description": "A PDF editor built with Tauri and Rust.",
  "author": "Roy Tian",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "test": "bun test",
    "test:all": "bun run test && bun run pdfium:download && bun run fonts:download && cargo test --manifest-path src-tauri/Cargo.toml --locked && cargo test --manifest-path src-tauri/Cargo.toml --locked -- --ignored && bun run test:e2e",
    "test:e2e": "bun run test:e2e:build && bun run test:e2e:headless",
    "test:e2e:build": "bun run pdfium:download && bun run fonts:download && bun run test:e2e:types && tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e:headless": "bun scripts/e2e-headless.mjs",
    "test:e2e:run": "wdio run wdio.conf.ts",
    "test:e2e:types": "tsc --noEmit -p tsconfig.e2e.json",
    "pdfium:download": "bun scripts/download-pdfium.mjs",
    "fonts:download": "bun scripts/download-fonts.mjs",
    "icons:generate": "bun scripts/generate-icons.mjs",
    "pretauri:dev": "bun run pdfium:download",
    "pretauri:build": "bun run pdfium:download",
    "pretauri:bundle": "bun run pdfium:download",
    "preview": "vite preview",
    "preflight": "bun scripts/preflight.mjs",
    "release": "bun scripts/release.ts",
    "changelog": "bun scripts/changelog.mjs",
    "prepare": "husky",
    "version:bump": "bun scripts/version.mjs",
    "version:check": "bun scripts/version.mjs --check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:bundle": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "~2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.7.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "expect": "29.7.0"
  }
}
