# Frontend dependencies and build output
node_modules/
dist/

# Rust build output
target/
src-tauri/target/

# Downloaded PDFium runtime libraries
src-tauri/resources/pdfium/*
!src-tauri/resources/pdfium/.gitkeep

# Downloaded CJK font for text notes
src-tauri/resources/fonts/*
!src-tauri/resources/fonts/.gitkeep

# Tauri-generated capability schemas
src-tauri/gen/schemas/

# Local environment files
.env
.env.*
!.env.example

# Logs and local overrides
logs/
artifacts/
*.log
*.local

# Editor and OS files
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Miscellaneous
.temp

# Agent and test tooling scratch (runtime artifacts, not source)
.pi-subagents/
.playwright/
scratchpad/
